+static void ipuSETTH(u32 val)
+{
+	g_ipu_thresh[0] = (val & 0x1ff);
+	g_ipu_thresh[1] = ((val >> 16) & 0x1ff);
+	IPU_LOG("SETTH (Set threshold value)command %x.", val&0x1ff01ff);
+}
