+struct VU1State;
+
+// Ahead-of-time compiled VU1 micro programs (generated C++ for a known code image).
+// A program runs from env.state->pc until its E-bit end and leaves every pipeline
+// (Q, P, MAC/status/clip flags) committed, like VU1Interpreter after a finished run.
+struct Vu1AotEnv
+{
+    VU1State *state = nullptr;
+    uint8_t *data = nullptr; // 16 KiB VU1 data memory
+    void (*kick)(void *user, uint32_t qwordAddress) = nullptr; // XGKICK (PATH1)
+    void *user = nullptr;
+    uint64_t pairs = 0; // executed instruction pairs (out)
+};
+
+// Returns false when it cannot run from env.state->pc (the caller then interprets).
+using Vu1AotProgram = bool (*)(Vu1AotEnv &env);
+
+// Debug: called at the start of every pair by compiled programs and by the interpreter while armed.
+extern void (*g_vu1AotTraceHook)(int side, uint32_t pc, const VU1State &state);
