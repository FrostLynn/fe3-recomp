diff --git a/ps2xRuntime/src/lib/ps2_ipu.cpp b/ps2xRuntime/src/lib/ps2_ipu.cpp
new file mode 100644
index 0000000..a500e54
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_ipu.cpp
@@ -0,0 +1,584 @@
+// SPDX-FileCopyrightText: 2026 PS2Recomp contributors
+// SPDX-License-Identifier: GPL-3.0+
+//
+// PS2Recomp adapter for the IPU core vendored from PCSX2 (upstream revision
+// 81526d4). Synchronous execution model: every MMIO entry point runs all
+// pending IPU work (command execution, FIFO feed/drain, DMA completion) to
+// quiescence before returning. UFE3 synchronizes via sceIpuSync only, so this
+// is behaviourally equivalent to PCSX2's scheduler-driven pumping for it.
+
+#include "ps2_ipu.h"
+
+#include "ipu/ipu_compat.h"
+#include "ipu/IPU.h"
+#include "ipu/IPUdma.h"
+#include "ipu/IPU_MultiISA.h"
+
+#include "runtime/ps2_memory.h"
+
+#include <vector>
+#include <deque>
+
+// ---------------------------------------------------------------------------
+// Shim objects referenced by the vendored core
+// ---------------------------------------------------------------------------
+
+IpuCpuRegsShim ipuCpuRegsShim;
+
+u32 ps2xIpuRawRead32(u32 addr)
+{
+	u32 v = 0;
+	std::memcpy(&v, reinterpret_cast<u8 *>(&ipuRegs) + (addr & 0xffu), 4);
+	return v;
+}
+
+u64 ps2xIpuRawRead64(u32 addr)
+{
+	u64 v = 0;
+	std::memcpy(&v, reinterpret_cast<u8 *>(&ipuRegs) + (addr & 0xffu), 8);
+	return v;
+}
+
+namespace
+{
+
+// PS2X_TRACE_IPU=1: same env gate as ps2_memory.cpp's IPU trace.
+bool ipuTraceEnabled()
+{
+	static const bool enabled = std::getenv("PS2X_TRACE_IPU") != nullptr;
+	return enabled;
+}
+
+// Pending scheduler events (upstream: CPU_INT). Dispatched by pump(); never
+// executed recursively from inside the core.
+bool s_pendingProcess = false;
+bool s_pendingFrom = false;
+bool s_pendingTo = false;
+bool s_pumping = false;
+
+PS2Memory *s_mem = nullptr;
+
+// Sticky CTRL.RST bit for readback (see writeCtrl below).
+uint32_t s_ctrlRstSticky = 0;
+
+// ch3 (fromIPU) state
+bool s_ch3Active = false;
+bool s_ch3Unbounded = false; // qwc == 0 as programmed -> 0x10000 "IPU-terminated" idiom
+
+// ch4 (toIPU) state: chain/normal payloads are staged here and fed into the
+// 8-qword in-FIFO on demand (upstream stalls the DMA on a full FIFO).
+std::vector<u8> s_ch4Staging;
+bool s_ch4Active = false;
+
+u32 s_ch4Madr = 0;
+u32 s_ch4Qwc = 0; // bounded transfers only (0 = unbounded)
+
+constexpr u32 kCh3Base = 0x1000B000u;
+constexpr u32 kCh4Base = 0x1000B400u;
+
+void raiseIpuIntc()
+{
+	if (s_mem)
+		s_mem->ipuRaiseIntcIrq(8); // INTC_IPU
+}
+
+void completeCh3()
+{
+	s_ch3Active = false;
+	ipu0ch.chcr.STR = false;
+	if (s_ch3Unbounded)
+	{
+		ipu0ch.qwc = 0;
+		s_ch3Unbounded = false;
+	}
+	if (s_mem)
+		s_mem->ipuCompleteDmacChannel(kCh3Base, 3); // DMAC_FROM_IPU
+}
+
+void completeCh4()
+{
+	s_ch4Active = false;
+	ipu1ch.chcr.STR = false;
+	s_ch4Staging.clear();
+	if (s_mem)
+		s_mem->ipuCompleteDmacChannel(kCh4Base, 4); // DMAC_TO_IPU
+}
+
+// One toIPU feed step (upstream: IPU1chain/IPU1dma). Demand-driven: the IPU
+// core raises IPUCoreStatus.DataRequested when its in-FIFO drops to <= 1 qword.
+void feedStep()
+{
+	if (!s_ch4Active || !ipu1ch.chcr.STR)
+		return;
+	if (!IPUCoreStatus.DataRequested)
+	{
+		CPU_SET_DMASTALL(DMAC_TO_IPU, true);
+		return;
+	}
+
+	const int space = 8 - static_cast<int>(g_BP.IFC);
+	int have = static_cast<int>(s_ch4Staging.size() / 16);
+	int n = std::min(space, have);
+	if (s_ch4Qwc != 0)
+		n = std::min(n, static_cast<int>(s_ch4Qwc));
+	while (n > 0)
+	{
+		mem128_t qw;
+		std::memcpy(&qw, s_ch4Staging.data(), 16);
+		if (ipu_fifo.in.write(qw._u32, 1) <= 0)
+			break;
+		s_ch4Staging.erase(s_ch4Staging.begin(), s_ch4Staging.begin() + 16);
+		ipu1ch.madr += 16;
+		if (s_ch4Qwc != 0)
+			--s_ch4Qwc;
+		--n;
+
+		// Upstream: once the FIFO has data again, restart a stalled command.
+		if (ipuRegs.ctrl.BUSY && IPUCoreStatus.WaitingOnIPUTo)
+		{
+			IPUCoreStatus.WaitingOnIPUTo = false;
+			s_pendingProcess = true;
+		}
+	}
+	CPU_SET_DMASTALL(DMAC_TO_IPU, s_ch4Staging.empty());
+}
+
+// One fromIPU drain step (upstream: IPU0dma).
+void drainStep()
+{
+	if (!s_ch3Active || !ipu0ch.chcr.STR)
+		return;
+	if (ipuRegs.ctrl.OFC == 0)
+	{
+		// FIFO dry: a command waiting to emit output can be restarted now.
+		if (ipuRegs.ctrl.BUSY && IPUCoreStatus.WaitingOnIPUFrom)
+		{
+			IPUCoreStatus.WaitingOnIPUFrom = false;
+			s_pendingProcess = true;
+		}
+		return;
+	}
+
+	u32 readsize = static_cast<u32>(ipuRegs.ctrl.OFC);
+	if (!s_ch3Unbounded)
+		readsize = std::min(readsize, ipu0ch.qwc);
+	if (readsize == 0)
+		return;
+
+	for (u32 i = 0; i < readsize; ++i)
+	{
+		mem128_t qw;
+		ipu_fifo.out.read(&qw, 1);
+		if (s_mem)
+			s_mem->write128(ipu0ch.madr, _mm_loadu_si128(reinterpret_cast<const __m128i *>(&qw)));
+		ipu0ch.madr += 16;
+	}
+
+	if (!s_ch3Unbounded)
+		ipu0ch.qwc -= readsize;
+
+	// DMAC stall-address tracking (D_CTRL.STS == fromIPU).
+	if (s_mem)
+		s_mem->ipuUpdateStadr(ipu0ch.madr);
+
+	if (!s_ch3Unbounded && ipu0ch.qwc == 0)
+	{
+		completeCh3();
+		return;
+	}
+
+	if (ipuRegs.ctrl.BUSY && IPUCoreStatus.WaitingOnIPUFrom)
+	{
+		IPUCoreStatus.WaitingOnIPUFrom = false;
+		s_pendingProcess = true;
+	}
+}
+
+bool inputEverComing()
+{
+	if (!s_ch4Staging.empty())
+		return true;
+	if (s_ch4Active && ipu1ch.chcr.STR)
+		return true;
+	return false;
+}
+
+} // namespace
+
+void ps2xIpuCpuInt(u32 cause, u32 cycles)
+{
+	(void)cycles;
+	switch (cause)
+	{
+	case IPU_PROCESS:
+		if (!(ipuCpuRegsShim.interrupt & (1u << IPU_PROCESS)))
+		{
+			ipuCpuRegsShim.interrupt |= 1u << IPU_PROCESS;
+			s_pendingProcess = true;
+		}
+		break;
+	case DMAC_TO_IPU:
+		if (!(ipuCpuRegsShim.interrupt & (1u << DMAC_TO_IPU)))
+		{
+			ipuCpuRegsShim.interrupt |= 1u << DMAC_TO_IPU;
+			s_pendingTo = true;
+		}
+		break;
+	case DMAC_FROM_IPU:
+		if (!(ipuCpuRegsShim.interrupt & (1u << DMAC_FROM_IPU)))
+		{
+			ipuCpuRegsShim.interrupt |= 1u << DMAC_FROM_IPU;
+			s_pendingFrom = true;
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+void ps2xIpuHwIntcIrq(u32 cause)
+{
+	if (cause == INTC_IPU)
+		raiseIpuIntc();
+}
+
+// ---------------------------------------------------------------------------
+// Upstream DMA handler entry points (IPUdma.h), mapped onto the synchronous
+// transfer engine above.
+// ---------------------------------------------------------------------------
+
+void ipuCMDProcess()
+{
+	IPUProcessInterrupt();
+}
+
+void IPU1dma()
+{
+	feedStep();
+}
+
+void IPU0dma()
+{
+	drainStep();
+}
+
+void ipu1Interrupt()
+{
+	if (!s_ch4Active)
+		return;
+	if (!s_ch4Staging.empty() || ipuRegs.ctrl.BUSY)
+	{
+		feedStep();
+		return;
+	}
+	completeCh4();
+}
+
+void ipu0Interrupt()
+{
+	if (!s_ch3Active)
+		return;
+	if (ipuRegs.ctrl.OFC != 0)
+	{
+		drainStep();
+		return;
+	}
+	// Upstream ends the qwc==0 transfer once the out-FIFO runs dry.
+	if (!ipuRegs.ctrl.BUSY)
+		completeCh3();
+}
+
+void dmaIPU0()
+{
+	ps2_ipu::pump();
+}
+
+void dmaIPU1()
+{
+	ps2_ipu::pump();
+}
+
+// ---------------------------------------------------------------------------
+// Adapter API
+// ---------------------------------------------------------------------------
+
+namespace ps2_ipu
+{
+
+void setMemory(PS2Memory *mem)
+{
+	s_mem = mem;
+}
+
+void reset()
+{
+	ipuReset();
+	s_pendingProcess = s_pendingFrom = s_pendingTo = false;
+	s_ctrlRstSticky = 0;
+	s_ch3Active = false;
+	s_ch3Unbounded = false;
+	s_ch4Active = false;
+	s_ch4Staging.clear();
+	s_ch4Madr = 0;
+	s_ch4Qwc = 0;
+}
+
+void writeCmd(uint32_t value)
+{
+	IPUCMD_WRITE(value);
+	pump();
+}
+
+void writeCtrl(uint32_t value)
+{
+	// The RST bit (30) is a write-1-to-reset bit. PCSX2's core self-clears it in
+	// ipuSoftReset(); the runtime's register model (and its tests) read the last
+	// written value back, so latch it here until the next CTRL write. UFE3 never
+	// reads CTRL (Finding 7), so this cannot affect game behaviour.
+	s_ctrlRstSticky = value & (1u << 30);
+	ipuWrite32(0x10002010u, value);
+	pump();
+}
+
+uint32_t readCmd()
+{
+	return ipuRead32(0x10002000u);
+}
+
+uint32_t readCtrl()
+{
+	return ipuRead32(0x10002010u) | s_ctrlRstSticky;
+}
+
+uint32_t readBp()
+{
+	return ipuRead32(0x10002020u);
+}
+
+uint32_t readTop()
+{
+	return ipuRead32(0x10002030u);
+}
+
+void fifoInWrite128(const void *qword)
+{
+	WriteFIFO_IPUin(reinterpret_cast<const mem128_t *>(qword));
+	pump();
+}
+
+bool fifoOutRead128(void *qword)
+{
+	if (ipuRegs.ctrl.OFC == 0)
+	{
+		std::memset(qword, 0, 16);
+		return false;
+	}
+	ReadFIFO_IPUout(reinterpret_cast<mem128_t *>(qword));
+	pump();
+	return true;
+}
+
+uint32_t fifoOutRead32()
+{
+	uint32_t value = 0;
+	if (ipuRegs.ctrl.OFC != 0)
+	{
+		mem128_t qw;
+		ReadFIFO_IPUout(&qw);
+		value = qw._u32[0];
+	}
+	pump();
+	return value;
+}
+
+void ch3Kick(uint32_t madr, uint32_t qwc, uint32_t chcr)
+{
+	// The runtime's CHCR start bit is 0x100; the core's tIPU_DMA_CHCR.STR is bit 0.
+	// Map explicitly so ipu0ch.chcr.STR reflects the channel being active.
+	ipu0ch.chcr._u32 = 0;
+	ipu0ch.chcr.STR = 1;
+	ipu0ch.chcr.MOD = static_cast<u32>((chcr >> 2) & 0x3u);
+	ipu0ch.chcr.TTE = (chcr & 0x40u) ? 1u : 0u;
+	ipu0ch.chcr.TIE = (chcr & 0x80u) ? 1u : 0u;
+	ipu0ch.madr = madr & 0xFFFFFFF0u;
+	ipu0ch.qwc = qwc & 0xFFFFu;
+	ipu0ch.tadr = 0;
+	s_ch3Active = true;
+	s_ch3Unbounded = (ipu0ch.qwc == 0);
+	if (s_ch3Unbounded)
+		ipu0ch.qwc = 0x10000; // upstream's "qwc 0 => 0x10000" IPU-terminated idiom
+	CPU_SET_DMASTALL(DMAC_FROM_IPU, false);
+	pump();
+}
+
+void ch4KickNormal(uint32_t madr, uint32_t qwc)
+{
+	ipu1ch.chcr._u32 = 0;
+	ipu1ch.chcr.STR = 1;
+	ipu1ch.chcr.MOD = 0;
+	ipu1ch.madr = madr & 0xFFFFFFF0u;
+	ipu1ch.qwc = qwc & 0xFFFFu;
+	ipu1ch.tadr = 0;
+	s_ch4Active = true;
+	s_ch4Madr = ipu1ch.madr;
+	s_ch4Qwc = ipu1ch.qwc;
+	s_ch4Staging.clear();
+
+	if (s_mem)
+	{
+		for (u32 i = 0; i < ipu1ch.qwc; ++i)
+		{
+			__m128i qw = s_mem->read128(ipu1ch.madr + i * 16u);
+			u8 bytes[16];
+			_mm_storeu_si128(reinterpret_cast<__m128i *>(bytes), qw);
+			s_ch4Staging.insert(s_ch4Staging.end(), bytes, bytes + 16);
+		}
+	}
+	CPU_SET_DMASTALL(DMAC_TO_IPU, false);
+	pump();
+}
+
+void ch4SubmitChain(const uint8_t *data, size_t sizeBytes, uint32_t tadrAfter)
+{
+	if (ipuTraceEnabled())
+	{
+		std::fprintf(stderr, "[trace:ipu] ch4 feed %zu bytes:", sizeBytes);
+		const size_t n = std::min<size_t>(sizeBytes, 32);
+		for (size_t i = 0; i < n; ++i)
+			std::fprintf(stderr, " %02X", data ? data[i] : 0u);
+		std::fprintf(stderr, "%s\n", sizeBytes > n ? " ..." : "");
+	}
+	ipu1ch.chcr._u32 = 0;
+	ipu1ch.chcr.STR = 1;
+	ipu1ch.chcr.MOD = 1;
+	ipu1ch.tadr = tadrAfter;
+	ipu1ch.madr = 0;
+	ipu1ch.qwc = 0;
+	s_ch4Active = true;
+	s_ch4Qwc = 0; // chain transfers are tag-sized; completion = staging drained
+	if (data && sizeBytes)
+		s_ch4Staging.insert(s_ch4Staging.end(), data, data + sizeBytes);
+	CPU_SET_DMASTALL(DMAC_TO_IPU, false);
+	pump();
+}
+
+void ch3Stop()
+{
+	// Guest abort (CHCR.STR cleared): stop silently, no DMAC completion IRQ.
+	s_ch3Active = false;
+	s_ch3Unbounded = false;
+	ipu0ch.chcr.STR = false;
+	ipu0ch.qwc = 0;
+}
+
+void ch4Stop()
+{
+	s_ch4Active = false;
+	s_ch4Staging.clear();
+	ipu1ch.chcr.STR = false;
+}
+
+void pump()
+{
+	if (s_pumping)
+		return;
+	s_pumping = true;
+
+	const int kGuard = 1 << 24;
+	for (int i = 0; i < kGuard; ++i)
+	{
+		if (s_pendingProcess)
+		{
+			s_pendingProcess = false;
+			ipuCpuRegsShim.interrupt &= ~(1u << IPU_PROCESS);
+			ipuCMDProcess();
+			continue;
+		}
+		if (s_pendingFrom)
+		{
+			s_pendingFrom = false;
+			ipuCpuRegsShim.interrupt &= ~(1u << DMAC_FROM_IPU);
+			ipu0Interrupt();
+			continue;
+		}
+		if (s_pendingTo)
+		{
+			s_pendingTo = false;
+			ipuCpuRegsShim.interrupt &= ~(1u << DMAC_TO_IPU);
+			ipu1Interrupt();
+			continue;
+		}
+
+		bool progressed = false;
+
+		if (s_ch4Active && !s_ch4Staging.empty() && IPUCoreStatus.DataRequested)
+		{
+			feedStep();
+			progressed = true;
+			continue;
+		}
+		if (s_ch3Active && ipuRegs.ctrl.OFC != 0)
+		{
+			drainStep();
+			progressed = true;
+			continue;
+		}
+
+		// Restart a stalled command when its wait condition is satisfied.
+		if (ipuRegs.ctrl.BUSY)
+		{
+			if (IPUCoreStatus.WaitingOnIPUFrom && s_ch3Active && ipuRegs.ctrl.OFC == 0 &&
+			    (s_ch3Unbounded || ipu0ch.qwc != 0))
+			{
+				IPUCoreStatus.WaitingOnIPUFrom = false;
+				s_pendingProcess = true;
+				progressed = true;
+				continue;
+			}
+			if (IPUCoreStatus.WaitingOnIPUTo && g_BP.IFC > 0)
+			{
+				IPUCoreStatus.WaitingOnIPUTo = false;
+				s_pendingProcess = true;
+				progressed = true;
+				continue;
+			}
+		}
+
+		// Completions.
+		if (s_ch4Active && s_ch4Staging.empty())
+		{
+			completeCh4();
+			progressed = true;
+			continue;
+		}
+		if (s_ch3Active && ipuRegs.ctrl.OFC == 0)
+		{
+			const bool commandDone = !ipuRegs.ctrl.BUSY;
+			const bool stalledForever = ipuRegs.ctrl.BUSY && IPUCoreStatus.WaitingOnIPUTo && g_BP.IFC == 0 &&
+			                            !inputEverComing();
+			if ((commandDone || stalledForever) && !s_pendingProcess && !s_pendingFrom && !s_pendingTo)
+			{
+				completeCh3();
+				progressed = true;
+				continue;
+			}
+		}
+
+		if (!progressed)
+			break;
+	}
+
+	s_pumping = false;
+}
+
+bool commandBusy()
+{
+	return ipuRegs.ctrl.BUSY != 0;
+}
+
+uint32_t outFifoCount()
+{
+	return static_cast<uint32_t>(ipuRegs.ctrl.OFC);
+}
+
+} // namespace ps2_ipu
