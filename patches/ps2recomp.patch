+    uint16_t IopMemory::spuReg(uint32_t phys) const
+    {
+        return static_cast<uint16_t>(readHardware32(phys & ~3u) >> ((phys & 2u) * 8u));
+    }
+
+    void IopMemory::setSpuReg(uint32_t phys, uint16_t value)
+    {
+        const uint32_t shift = (phys & 2u) * 8u;
+        uint32_t &word = m_hardware[phys & ~3u];
+        word = (word & ~(0xFFFFu << shift)) | (static_cast<uint32_t>(value) << shift);
+    }
+
+    // Register side effects. Core regs: core*0x400 + {voice*0x10+4 pitch, 0x19A ATTR, 0x1A0/2 KON, 0x1A4/6 KOFF,
+    // 0x1C0+voice*0xC SSA/LSAX/NAX (hi, lo), 0x340/2 ENDX}. Addresses are in halfwords.
+    void IopMemory::spu2Write16(uint32_t phys, uint16_t value)
+    {
+        const uint32_t offset = phys - kSpu2Base;
+        if (offset >= 0x760u)
+            return;
+        const uint32_t core = offset >= 0x400u ? 1u : 0u;
+        const uint32_t reg = offset - core * 0x400u;
+        const uint32_t base = kSpu2Base + core * 0x400u;
+        auto addr = [&](uint32_t hi) { return ((static_cast<uint32_t>(spuReg(hi)) << 16u) | spuReg(hi + 2u)) & (kSpuRamHalfwords - 1u); };
+
+        if (reg == 0x19Au && (value & kAttrIrqEnable) == 0u)
+            setSpuReg(kSpuIrqInfo, static_cast<uint16_t>(spuReg(kSpuIrqInfo) & ~(4u << core)));
+        else if (reg >= 0x1A0u && reg <= 0x1A6u)
+        {
+            const bool keyOn = reg < 0x1A4u;
+            const uint32_t first = (reg & 2u) ? 16u : 0u;
+            for (uint32_t bit = 0; bit < 16u && first + bit < 24u; ++bit)
+            {
+                if ((value & (1u << bit)) == 0u)
+                    continue;
+                SpuVoice &voice = m_voices[core][first + bit];
+                if (!keyOn)
+                {
+                    voice.on = false;
+                    continue;
+                }
+                const uint32_t regs = base + 0x1C0u + (first + bit) * 0xCu;
+                voice = {true, addr(regs), addr(regs + 4u), m_spuNow + blockCycles(spuReg(base + (first + bit) * 0x10u + 4u))};
+                m_spuNext = std::min(m_spuNext, voice.blockEnd);
+                const uint32_t endx = base + 0x340u + ((first + bit) >= 16u ? 2u : 0u);
+                setSpuReg(endx, static_cast<uint16_t>(spuReg(endx) & ~(1u << ((first + bit) & 15u))));
+            }
+        }
+        else if (reg >= 0x1C0u && reg < 0x1C0u + 24u * 0xCu && ((reg - 0x1C0u) % 0xCu) / 4u == 1u)
+            m_voices[core][(reg - 0x1C0u) / 0xCu].lsa = addr(base + reg - ((reg - 0x1C0u) % 0xCu) + 4u);
+    }
+
+    // Walks each keyed-on voice block by block (28 samples per 16-byte ADPCM block at 48 kHz * pitch/0x1000),
+    // honouring the block flags (bit 2 loop start, bit 0 loop end, bit 1 repeat), and raises the core's IRQ
+    // when a finished block contained IRQA while ATTR bit 6 is set.
+    // ponytail: block granularity and no DMA-access IRQA hits; per-sample timing only matters for real audio output.
+    bool IopMemory::spu2Advance(uint64_t now)
+    {
+        m_spuNow = now;
+        if (now < m_spuNext)
+            return false;
+        m_spuNext = UINT64_MAX;
+        bool raised = false;
+        for (uint32_t core = 0; core < 2u; ++core)
+        {
+            const uint32_t base = kSpu2Base + core * 0x400u;
+            for (uint32_t v = 0; v < 24u; ++v)
+            {
+                SpuVoice &voice = m_voices[core][v];
+                while (voice.on && voice.blockEnd <= now)
+                {
+                    // The block at nax finished playing: apply its flags, then start the next one.
+                    const uint8_t flags = static_cast<uint8_t>(m_spuRam[voice.nax] >> 8u);
+                    if (flags & 4u)
+                        voice.lsa = voice.nax;
+                    const uint32_t irqa = ((static_cast<uint32_t>(spuReg(base + 0x19Cu)) << 16u) | spuReg(base + 0x19Eu)) & (kSpuRamHalfwords - 1u);
+                    if ((spuReg(base + 0x19Au) & kAttrIrqEnable) != 0u && irqa >= voice.nax && irqa < voice.nax + 8u &&
+                        (spuReg(kSpuIrqInfo) & (4u << core)) == 0u)
+                    {
+                        setSpuReg(kSpuIrqInfo, static_cast<uint16_t>(spuReg(kSpuIrqInfo) | (4u << core)));
+                        raised = true;
+                    }
+                    if (flags & 1u)
+                    {
+                        const uint32_t endx = base + 0x340u + (v >= 16u ? 2u : 0u);
+                        setSpuReg(endx, static_cast<uint16_t>(spuReg(endx) | (1u << (v & 15u))));
+                        if ((flags & 2u) == 0u)
+                            voice.on = false;
+                        voice.nax = voice.lsa;
+                    }
+                    else
+                        voice.nax = (voice.nax + 8u) & (kSpuRamHalfwords - 1u);
+                    const uint32_t regs = base + 0x1C0u + v * 0xCu;
+                    setSpuReg(regs + 8u, static_cast<uint16_t>(voice.nax >> 16u));
+                    setSpuReg(regs + 0xAu, static_cast<uint16_t>(voice.nax));
+                    voice.blockEnd += blockCycles(spuReg(base + v * 0x10u + 4u));
+                }
+                if (voice.on)
+                    m_spuNext = std::min(m_spuNext, voice.blockEnd);
+            }
+        }
+        return raised;
+    }
+
+    uint64_t IopMemory::spu2NextEvent(uint64_t limit) const
+    {
+        for (uint32_t core = 0; core < 2u; ++core)
+        {
+            if ((spuReg(kSpu2Base + core * 0x400u + 0x19Au) & kAttrIrqEnable) == 0u)
+                continue;
+            for (const SpuVoice &voice : m_voices[core])
+                if (voice.on)
+                    limit = std::min(limit, voice.blockEnd);
+        }
+        return limit;
+    }
