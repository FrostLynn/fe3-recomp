+void ps2ReportFloatEvent(const char *what, uint32_t pc, float a, float b, float result)
+{
+    static int reports = 0;
+    static uint32_t seenPcs[512];
+    static int nseen = 0;
+    for (int i = 0; i < nseen; ++i)
+        if (seenPcs[i] == pc)
+            return;
+    if (nseen < 512)
+        seenPcs[nseen++] = pc;
+    if (++reports > 300)
+        return;
+    uint32_t ab, bb, rb;
+    std::memcpy(&ab, &a, 4);
+    std::memcpy(&bb, &b, 4);
+    std::memcpy(&rb, &result, 4);
+    std::fprintf(stderr, "[float] %s pc=0x%x a=%08x(%g) b=%08x(%g) r=%08x\n", what, pc, ab, a, bb, b, rb);
+}
