+// PS2X_PROFILE=<file>: SIGPROF sampler. Every 1 ms of process CPU time the interrupted RIP is
+// counted; every 15 s the histogram (rip offsets from the executable's load base) is rewritten
+// to <file>. Resolve offline against `nm -C ps2EntryRunner`.
+namespace
+{
+    constexpr size_t kProfSlots = 1u << 20;
+    std::atomic<uint64_t> g_profRip[kProfSlots];
+    std::atomic<uint32_t> g_profCount[kProfSlots];
+
+    void profSignal(int, siginfo_t *, void *uctx)
+    {
+        // PS2X_PROFILE_THREAD=<name>: only sample threads with that name (e.g. GameThread).
+        static const char *only = std::getenv("PS2X_PROFILE_THREAD");
+        if (only)
+        {
+            char name[16] = {};
+            prctl(PR_GET_NAME, name, 0, 0, 0);
+            if (std::strncmp(name, only, 15) != 0)
+                return;
+        }
+        const uint64_t rip = static_cast<uint64_t>(static_cast<ucontext_t *>(uctx)->uc_mcontext.gregs[REG_RIP]);
+        size_t slot = (rip * 0x9E3779B97F4A7C15ull) >> 44;
+        for (int probe = 0; probe < 32; ++probe, slot = (slot + 1) & (kProfSlots - 1))
+        {
+            uint64_t expected = 0;
+            if (g_profRip[slot].load(std::memory_order_relaxed) == rip ||
+                g_profRip[slot].compare_exchange_strong(expected, rip, std::memory_order_relaxed))
+            {
+                g_profCount[slot].fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+        }
+    }
+
+    const bool g_profStarted = []()
+    {
+        const char *path = std::getenv("PS2X_PROFILE");
+        if (!path)
+            return false;
+        struct sigaction sa{};
+        sa.sa_sigaction = profSignal;
+        sa.sa_flags = SA_SIGINFO | SA_RESTART;
+        sigaction(SIGPROF, &sa, nullptr);
+        itimerval tv{{0, 1000}, {0, 1000}};
+        setitimer(ITIMER_PROF, &tv, nullptr);
+        std::thread([out = std::string(path)]()
+                    {
+            Dl_info info{};
+            dladdr(reinterpret_cast<void *>(&profSignal), &info);
+            const uint64_t base = reinterpret_cast<uint64_t>(info.dli_fbase);
+            for (;;)
+            {
+                std::this_thread::sleep_for(std::chrono::seconds(15));
+                if (FILE *f = std::fopen(out.c_str(), "w"))
+                {
+                    for (size_t i = 0; i < kProfSlots; ++i)
+                        if (const uint32_t c = g_profCount[i].load(std::memory_order_relaxed))
+                            std::fprintf(f, "%u %llx\n", c, (unsigned long long)(g_profRip[i].load() - base));
+                    std::fclose(f);
+                }
+                // Shared-library samples resolve against <file>.maps (offsets are from the exe base).
+                if (FILE *f = std::fopen((out + ".maps").c_str(), "w"))
+                {
+                    std::fprintf(f, "base %llx\n", (unsigned long long)base);
+                    if (FILE *m = std::fopen("/proc/self/maps", "r"))
+                    {
+                        char line[512];
+                        while (std::fgets(line, sizeof(line), m))
+                            std::fputs(line, f);
+                        std::fclose(m);
+                    }
+                    std::fclose(f);
+                }
+            } })
+            .detach();
+        return true;
+    }();
+}
