diff --git a/ps2xRuntime/src/lib/ipu/ipu_compat.h b/ps2xRuntime/src/lib/ipu/ipu_compat.h
new file mode 100644
index 0000000..cd013da
--- /dev/null
+++ b/ps2xRuntime/src/lib/ipu/ipu_compat.h
@@ -0,0 +1,217 @@
+// SPDX-FileCopyrightText: 2026 PS2Recomp contributors
+// SPDX-License-Identifier: GPL-3.0+
+//
+// Compatibility shim for the IPU core vendored from PCSX2
+// (https://github.com/PCSX2/pcsx2). This header itself contains no PCSX2 code;
+// it supplies the types, macros and host hooks the vendored core expects.
+//
+// Ported from PCSX2, upstream revision 81526d4. See THIRD_PARTY.md.
+
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdarg>
+#include <string>
+#include <array>
+#include <algorithm>
+#include <limits>
+
+#include <emmintrin.h>
+
+// ---------------------------------------------------------------------------
+// Basic types (PCSX2 Common.h / Pcsx2Defs.h subset)
+// ---------------------------------------------------------------------------
+
+using u8 = uint8_t;
+using u16 = uint16_t;
+using u32 = uint32_t;
+using u64 = uint64_t;
+using s8 = int8_t;
+using s16 = int16_t;
+using s32 = int32_t;
+using s64 = int64_t;
+using uint = unsigned int;
+using uptr = uintptr_t;
+
+struct alignas(16) u128
+{
+	union
+	{
+		u8 _u8[16];
+		u16 _u16[8];
+		u32 _u32[4];
+		u64 _u64[2];
+	};
+};
+static_assert(sizeof(u128) == 16, "u128 must be exactly 16 bytes");
+
+using mem128_t = u128;
+
+// [PS2Recomp port] IPU register addresses (upstream: PCSX2 Hw.h).
+#define IPU_CMD 0x10002000u
+#define IPU_CTRL 0x10002010u
+#define IPU_BP 0x10002020u
+#define IPU_TOP 0x10002030u
+
+// [PS2Recomp port] Minimal r128 SIMD helpers (upstream: PCSX2 r128.h), SSE2.
+using r128 = __m128i;
+inline r128 r128_zero() { return _mm_setzero_si128(); }
+inline r128 r128_load(const void *p) { return _mm_loadu_si128(reinterpret_cast<const __m128i *>(p)); }
+inline void r128_store(void *p, r128 v) { _mm_storeu_si128(reinterpret_cast<__m128i *>(p), v); }
+inline r128 r128_from_u32_dup(u32 v) { return _mm_set1_epi32(static_cast<int>(v)); }
+
+inline void CopyQWC(void* dest, const void* src)
+{
+	std::memcpy(dest, src, 16);
+}
+
+// ---------------------------------------------------------------------------
+// Attributes / assertion macros
+// ---------------------------------------------------------------------------
+
+// Upstream uses __fi/__ri as inline hints. They are mapped to nothing so that
+// non-static functions defined with them keep external linkage across TUs
+// (static ones are still inlined by the optimiser as usual).
+#define __fi
+#define __ri
+#define __noinline
+
+// Asserts evaluate their condition (so side effects are preserved as upstream)
+// but never abort: a broken stream must not kill a game run. Failures are
+// visible through the normal trace channels instead.
+#define pxAssert(cond) ((void)(cond))
+#define pxAssertMsg(cond, msg) ((void)(cond))
+#define pxAssume(cond) ((void)(cond))
+#define pxAssumeMsg(cond, msg) ((void)(cond))
+#define jASSUME(cond) ((void)(cond))
+
+#define jNO_DEFAULT                                                                                                    \
+	default:                                                                                                           \
+		std::fprintf(stderr, "[ipu] unexpected switch default at %s:%d\n", __FILE__, __LINE__);                        \
+		break;
+
+// PCSX2 debug logging: enabled by PS2X_TRACE_IPU (same env gate as adapter-level tracing).
+inline bool ps2xIpuLogEnabled()
+{
+	static const bool enabled = std::getenv("PS2X_TRACE_IPU") != nullptr;
+	return enabled;
+}
+#define IPU_LOG(...)                                                                                                   \
+	do                                                                                                                 \
+	{                                                                                                                  \
+		if (ps2xIpuLogEnabled())                                                                                       \
+		{                                                                                                              \
+			std::fprintf(stderr, "[ipu] " __VA_ARGS__);                                                                \
+			std::fprintf(stderr, "\n");                                                                                \
+		}                                                                                                              \
+	} while (0)
+
+constexpr bool IsDebugBuild = false;
+
+// ---------------------------------------------------------------------------
+// StringUtil subset (used only by the desc() helpers)
+// ---------------------------------------------------------------------------
+
+namespace StringUtil
+{
+	inline std::string StdStringFromFormat(const char* fmt, ...)
+	{
+		va_list args;
+		va_start(args, fmt);
+		va_list args2;
+		va_copy(args2, args);
+		const int len = std::vsnprintf(nullptr, 0, fmt, args);
+		va_end(args);
+		std::string result;
+		if (len > 0)
+		{
+			result.resize(static_cast<size_t>(len));
+			std::vsnprintf(result.data(), result.size() + 1, fmt, args2);
+		}
+		va_end(args2);
+		return result;
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Console / DevCon logging sinks (discarded)
+// ---------------------------------------------------------------------------
+
+struct IpuLogSink
+{
+	template <typename... A>
+	void WriteLn(A&&...)
+	{
+	}
+	template <typename... A>
+	void Error(A&&...)
+	{
+	}
+	template <typename... A>
+	void Warning(A&&...)
+	{
+	}
+};
+
+inline IpuLogSink Console;
+inline IpuLogSink DevCon;
+
+// ---------------------------------------------------------------------------
+// Minimal CPU-register view used by the core (cycle counting / interrupt
+// scheduling flags only; the runtime's real scheduling is synchronous).
+// ---------------------------------------------------------------------------
+
+struct IpuCpuRegsShim
+{
+	u64 cycle = 0;
+	u32 interrupt = 0;
+	u32 pc = 0;
+	u32 eCycle[32] = {};
+};
+
+extern IpuCpuRegsShim ipuCpuRegsShim;
+#define cpuRegs ipuCpuRegsShim
+
+// Raw HW peek used by ipuRead32/64 fallbacks (reads the register file backing).
+u32 ps2xIpuRawRead32(u32 addr);
+u64 ps2xIpuRawRead64(u32 addr);
+#define psHu32(a) ps2xIpuRawRead32(a)
+#define psHu64(a) ps2xIpuRawRead64(a)
+
+// ---------------------------------------------------------------------------
+// Scheduler / IRQ hooks. In this synchronous port "CPU_INT" only records a
+// pending event; ps2_ipu.cpp's pump loop dispatches it (never recursively).
+// ---------------------------------------------------------------------------
+
+#define BIAS 1
+
+#define DMAC_FROM_IPU 3
+#define DMAC_TO_IPU 4
+#define IPU_PROCESS 20
+
+#define INTC_IPU 8
+
+void ps2xIpuCpuInt(u32 cause, u32 cycles);
+#define CPU_INT(cause, cycles) ps2xIpuCpuInt((cause), (cycles))
+
+#define CPU_SET_DMASTALL(cause, on) ((ipuCpuRegsShim.eCycle[(cause)] = (on) ? 0x9999u : 0u))
+
+void ps2xIpuHwIntcIrq(u32 cause);
+#define hwIntcIrq(cause) ps2xIpuHwIntcIrq(cause)
+
+// ---------------------------------------------------------------------------
+// Multi-ISA machinery: compile the core once (x86-64 SSE2 / scalar).
+// ---------------------------------------------------------------------------
+
+#if defined(__x86_64__) || defined(_M_X64) || defined(__i386__) || defined(_M_IX86)
+#define ARCH_X86 1
+#endif
+
+#define MULTI_ISA_COMPILE_ONCE 1
+#define MULTI_ISA_DEF(...) __VA_ARGS__
+#define MULTI_ISA_UNSHARED_START
+#define MULTI_ISA_UNSHARED_END
+#define MULTI_ISA_SELECT(fn) fn
diff --git a/ps2xRuntime/src/lib/ipu/ipu_core.cpp b/ps2xRuntime/src/lib/ipu/ipu_core.cpp
new file mode 100644
index 0000000..c6d56e9
--- /dev/null
+++ b/ps2xRuntime/src/lib/ipu/ipu_core.cpp
@@ -0,0 +1,2918 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+// SPDX-License-Identifier: GPL-2.0+
+//
+// Ported from PCSX2 (https://github.com/PCSX2/pcsx2), upstream revision 81526d4.
+// Vendored/derived from pcsx2/IPU/IPU.cpp, pcsx2/IPU/IPU_MultiISA.cpp and
+// pcsx2/IPU/mpeg2_vlc.h (merged per the port plan's target layout). The
+// VLC-table section derives from the mpeg2dec library (GPL-2.0+; see its
+// provenance comment below). See THIRD_PARTY.md at the worktree root.
+
+#include "ipu_core.h"
+#include "ipu_dma.h"
+
+// ==========================================================================
+// Vendored from pcsx2/IPU/mpeg2_vlc.h
+// ==========================================================================
+
+/* NOTE: While part of this header is originally from libmpeg2, which is GPL - licensed,
+ * it's not substantial and does not contain any functions, therefore can be argued
+ * not to be a derived work. See http://lkml.iu.edu/hypermail/linux/kernel/0301.1/0362.html
+ * The constants themselves can also be argued to be part of the MPEG-2 standard, whose
+ * patents expired worldwide in Feb 2020.
+ *
+ * Original copyright included for completeness:
+ *   Copyright (C) 2000-2002 Michel Lespinasse <walken@zoy.org>
+ *   Copyright (C) 1999-2000 Aaron Holtzman <aholtzma@ess.engr.uvic.ca>
+ */
+
+#define VLC_ALIGNED16 __attribute__((aligned(16)))
+
+enum macroblock_modes
+{
+	MACROBLOCK_INTRA = 1,
+	MACROBLOCK_PATTERN = 2,
+	MACROBLOCK_MOTION_BACKWARD = 4,
+	MACROBLOCK_MOTION_FORWARD = 8,
+	MACROBLOCK_QUANT = 16,
+	DCT_TYPE_INTERLACED = 32
+};
+
+enum motion_type
+{
+	MOTION_TYPE_SHIFT = 6,
+	MOTION_TYPE_MASK = (3 * 64),
+	MOTION_TYPE_BASE = 64,
+	MC_FIELD = (1 * 64),
+	MC_FRAME = (2 * 64),
+	MC_16X8 = (2 * 64),
+	MC_DMV = (3 * 64)
+};
+
+/* picture structure */
