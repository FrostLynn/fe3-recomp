+    bool sameState(const VU1State &a, const VU1State &b)
+    {
+        for (int r = 1; r < 32; ++r)
+            if (std::memcmp(a.vf[r], b.vf[r], 16) != 0)
+                return false;
+        for (int r = 1; r < 16; ++r)
+            if ((a.vi[r] & 0xFFFF) != (b.vi[r] & 0xFFFF))
+                return false;
+        return std::memcmp(a.acc, b.acc, 16) == 0 && std::memcmp(&a.q, &b.q, 4) == 0 && std::memcmp(&a.i, &b.i, 4) == 0 &&
+               (a.mac & 0xFFFF) == (b.mac & 0xFFFF) && (a.status & 0xFFF) == (b.status & 0xFFF);
+    }
+
+    void printStateDiff(const VU1State &a, const VU1State &b)
+    {
+        for (int r = 1; r < 32; ++r)
+            for (int c = 0; c < 4; ++c)
+                if (std::memcmp(&a.vf[r][c], &b.vf[r][c], 4) != 0)
+                    std::fprintf(stderr, "    vf%d.%c interp=%08x(%g) aot=%08x(%g)\n", r, "xyzw"[c], *(const uint32_t *)&a.vf[r][c], a.vf[r][c], *(const uint32_t *)&b.vf[r][c], b.vf[r][c]);
