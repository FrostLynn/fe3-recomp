+void VU1Interpreter::verifyAotAfterRun(const uint8_t *vuData)
+{
+    AotVerify &v = g_aotVerify;
+    if (!v.armed)
+        return;
+    v.armed = false;
+    ++v.runs;
+    std::string diff;
+    char buf[256];
+    for (int r = 1; r < 32 && diff.size() < 600; ++r)
+        for (int c = 0; c < 4; ++c)
+            if (std::memcmp(&m_state.vf[r][c], &v.state.vf[r][c], 4) != 0)
+            {
+                std::snprintf(buf, sizeof(buf), " vf%d.%c interp=%g aot=%g", r, "xyzw"[c], m_state.vf[r][c], v.state.vf[r][c]);
+                diff += buf;
+            }
+    for (int r = 1; r < 16; ++r)
+        if ((m_state.vi[r] & 0xFFFF) != (v.state.vi[r] & 0xFFFF))
+        {
+            std::snprintf(buf, sizeof(buf), " vi%d interp=%x aot=%x", r, m_state.vi[r] & 0xFFFF, v.state.vi[r] & 0xFFFF);
+            diff += buf;
+        }
+    for (int c = 0; c < 4; ++c)
+        if (std::memcmp(&m_state.acc[c], &v.state.acc[c], 4) != 0)
+        {
+            std::snprintf(buf, sizeof(buf), " acc.%c interp=%g aot=%g", "xyzw"[c], m_state.acc[c], v.state.acc[c]);
+            diff += buf;
+        }
+    if (std::memcmp(&m_state.q, &v.state.q, 4) != 0)
+    {
+        std::snprintf(buf, sizeof(buf), " q interp=%g aot=%g", m_state.q, v.state.q);
+        diff += buf;
+    }
+    if (m_state.pc != v.state.pc)
+    {
+        std::snprintf(buf, sizeof(buf), " pc interp=%x aot=%x", m_state.pc, v.state.pc);
+        diff += buf;
+    }
+    if ((m_state.mac & 0xFFFF) != (v.state.mac & 0xFFFF) || (m_state.status & 0xFFF) != (v.state.status & 0xFFF))
+    {
+        std::snprintf(buf, sizeof(buf), " mac %x/%x status %x/%x", m_state.mac & 0xFFFF, v.state.mac & 0xFFFF, m_state.status & 0xFFF, v.state.status & 0xFFF);
+        diff += buf;
+    }
+    for (uint32_t i = 0; i < 0x4000u; i += 16)
+        if (std::memcmp(vuData + i, v.data.data() + i, 16) != 0)
+        {
+            std::snprintf(buf, sizeof(buf), " mem[qw %x]", i / 16);
+            diff += buf;
+            break;
+        }
+    if (v.aotKicks.size() != v.interpKicks.size())
+    {
+        std::snprintf(buf, sizeof(buf), " kicks interp=%zu aot=%zu", v.interpKicks.size(), v.aotKicks.size());
+        diff += buf;
+    }
+    else
+        for (size_t k = 0; k < v.aotKicks.size(); ++k)
+            if (v.aotKicks[k] != v.interpKicks[k])
+            {
+                std::snprintf(buf, sizeof(buf), " kick#%zu differs (bytes %zu/%zu)", k, v.interpKicks[k].size(), v.aotKicks[k].size());
+                diff += buf;
+                break;
+            }
+    if (g_traceThisRun)
+    {
+        compareTraces();
+        g_traceThisRun = false;
+        g_vu1AotTraceHook = nullptr;
+    }
+    if (!diff.empty() && v.mismatches++ < 40)
+        std::fprintf(stderr, "[vu1aot-verify] run %llu start pc=0x%x:%s\n", (unsigned long long)v.runs, v.startPc, diff.c_str());
+    if ((v.runs % 20000u) == 0u)
+        std::fprintf(stderr, "[vu1aot-verify] %llu runs, %llu mismatching\n", (unsigned long long)v.runs, (unsigned long long)v.mismatches);
+    v.aotKicks.clear();
+    v.interpKicks.clear();
+}
