+    void verifyKick(void *user, uint32_t qwordAddress)
+    {
+        const uint8_t *mem = static_cast<const uint8_t *>(user);
+        const uint32_t start = (qwordAddress * 16u) & 0x3FF0u;
+        const uint32_t bytes = gifPacketBytes(mem, start);
+        std::vector<uint8_t> pkt(bytes);
+        for (uint32_t i = 0; i < bytes; ++i)
+            pkt[i] = mem[(start + i) & 0x3FFFu];
+        g_aotVerify.aotKicks.push_back(std::move(pkt));
+    }
