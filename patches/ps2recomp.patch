+void ps2ReportWatchedWrite(uint32_t guestAddr, uint32_t size, uint64_t valueLo, uint64_t valueHi, const char *op, const R5900Context *ctx)
+{
+    // With both PS2X_WATCH and PS2X_WATCH_VALUE set, report only stores that match both.
+    if (g_ps2WatchValueOn && g_ps2WatchLen != 0u)
+    {
+        const bool inRange = (((guestAddr & PS2_RAM_MASK) + size - 1u - g_ps2WatchLo) < g_ps2WatchLen + size - 1u);
+        const bool hasValue = size >= 4u && (static_cast<uint32_t>(valueLo) == g_ps2WatchValue || static_cast<uint32_t>(valueLo >> 32) == g_ps2WatchValue ||
+                                             static_cast<uint32_t>(valueHi) == g_ps2WatchValue || static_cast<uint32_t>(valueHi >> 32) == g_ps2WatchValue);
