+// SPDX-FileCopyrightText: 2026 PS2Recomp contributors
+// SPDX-License-Identifier: GPL-3.0+
+//
+// PS2Recomp adapter for the IPU (MPEG decoder) core vendored from PCSX2
+// (https://github.com/PCSX2/pcsx2). Registers, FIFOs and the ch3/ch4 DMA
+// engines are executed synchronously; see THIRD_PARTY.md.
+
+#pragma once
+
+#include <cstdint>
+#include <cstddef>
+
+class PS2Memory;
+
+namespace ps2_ipu
+{
+
+// Bind the runtime memory (used for ch3 output writes, ch4 input reads and
+// DMAC/INTC completion signalling). Called from PS2Memory::initialize().
+void setMemory(PS2Memory *mem);
+
+// Full IPU + DMA reset (CTRL.RST semantics / runtime reset).
+void reset();
+
+// MMIO: IPU registers (0x10002000 CMD, 0x10002010 CTRL, 0x10002020 BP,
+// 0x10002030 TOP).
+void writeCmd(uint32_t value);
+void writeCtrl(uint32_t value);
+uint32_t readCmd();
+uint32_t readCtrl();
+uint32_t readBp();
+uint32_t readTop();
+
+// MMIO: FIFOs. The in-FIFO (0x10007010) is 128-bit write-only, the out-FIFO
+// (0x10007000) is read as 128-bit or 32-bit.
+void fifoInWrite128(const void *qword);
+bool fifoOutRead128(void *qword); // false when the FIFO is empty (returns zeros)
+uint32_t fifoOutRead32();         // low dword of the head qword; pops the qword
+
+// DMA channels (kick = CHCR.STR set, stop = STR cleared by the guest).
+void ch3Kick(uint32_t madr, uint32_t qwc, uint32_t chcr); // fromIPU (normal mode)
+void ch4KickNormal(uint32_t madr, uint32_t qwc);          // toIPU (normal mode)
+// toIPU chain mode: ps2_memory.cpp's chain walker delivers the tag payload of
+// the whole chain; it feeds the in-FIFO on demand (8 qwords of backpressure).
+void ch4SubmitChain(const uint8_t *data, size_t sizeBytes, uint32_t tadrAfter);
+void ch3Stop();
+void ch4Stop();
+
+// Run all pending IPU work (command execution, FIFO feeds/drains, DMA
+// completion) to quiescence. Called after every MMIO entry point.
+void pump();
+
+// Debug/test access to decoded output state (see ps2_ipu_tests.cpp).
+bool commandBusy();
+uint32_t outFifoCount();
+
+} // namespace ps2_ipu
