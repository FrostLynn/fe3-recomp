+// Ported from PCSX2 (https://github.com/PCSX2/pcsx2), upstream revision 81526d4.
+// Adapted for PS2Recomp: the DMA channel register file and the ch3/ch4 transfer
+// engines live in ps2_ipu.cpp (synchronous execution model); this header keeps
+// the status structs and the register view the core reads.
+
+#pragma once
+
