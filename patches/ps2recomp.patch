+    uint32_t gifPacketBytes(const uint8_t *mem, uint32_t start)
+    {
+        uint32_t off = 0;
+        for (int guard = 0; guard < 4096; ++guard)
+        {
+            uint64_t tag;
+            std::memcpy(&tag, mem + ((start + off) & 0x3FF0u), 8);
+            const uint32_t nloop = tag & 0x7FFFu, flg = (tag >> 58) & 3u;
+            uint32_t nreg = (tag >> 60) & 0xFu;
+            if (nreg == 0) nreg = 16;
+            off += 16;
+            off += flg == 0 ? nloop * nreg * 16u : flg == 1 ? ((nloop * nreg + 1u) / 2u) * 16u : nloop * 16u;
+            if ((tag >> 15) & 1u || off >= 0x4000u)
+                break;
+        }
+        return std::min<uint32_t>(off, 0x4000u);
+    }
