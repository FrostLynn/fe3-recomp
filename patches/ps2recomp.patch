+static void ipuBCLR(u32 val)
+{
+	ipu_fifo.in.clear();
+	std::memset(&g_BP, 0, sizeof(g_BP));
+	g_BP.BP = val & 0x7F;
+
+	ipuRegs.cmd.BUSY = 0;
+	IPU_LOG("Clear IPU input FIFO. Set Bit offset=0x%X", g_BP.BP);
+}
