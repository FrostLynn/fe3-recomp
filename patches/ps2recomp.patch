+uint64_t ps2HashVu1Code(const uint8_t *code, uint32_t size)
+{
+    uint64_t hash = 0xCBF29CE484222325ull; // FNV-1a
+    for (uint32_t i = 0; i < size; ++i)
+        hash = (hash ^ code[i]) * 0x100000001B3ull;
+    return hash;
+}
