+                          value & 0x3F, (value >> 16) & 0x1F, (value >> 24) & 1, (value >> 25) & 1,
+                          (value >> 26) & 1, ((value >> 27) & 1) ? "RGB16" : "RGB32");
+            break;
+        case 2: // BDEC
+            std::snprintf(detail, sizeof(detail), "fb=%u qsc=%u dt=%u dcr=%u mbi=%u",
+                          value & 0x3F, (value >> 16) & 0x1F, (value >> 25) & 1, (value >> 26) & 1,
+                          (value >> 27) & 1);
+            break;
+        case 3: // VDEC: table = val[27:26] (0=MBAI, 1=MBT, 2=MC, 3=DMV)
+            std::snprintf(detail, sizeof(detail), "table=%u fb=%u", (value >> 26) & 3, value & 0x3F);
+            break;
+        case 4: // FDEC: reads 32 bits to TOP
+            std::snprintf(detail, sizeof(detail), "fb=%u", value & 0x3F);
+            break;
+        case 5: // SETIQ: val[27] selects non-intra matrix, 64 bytes from in-FIFO
+            std::snprintf(detail, sizeof(detail), "%s fb=%u",
+                          ((value >> 27) & 1) ? "non-intra" : "intra", value & 0x3F);
+            break;
+        case 6: // SETVQ: 32 bytes (16-entry CLUT) from in-FIFO
+            detail[0] = '\0';
+            break;
+        case 7: // CSC: YCbCr -> RGB
+            std::snprintf(detail, sizeof(detail), "mbc=%u dte=%u ofm=%s", value & 0x7FF,
+                          (value >> 26) & 1, ((value >> 27) & 1) ? "RGB16" : "RGB32");
+            break;
+        case 8: // PACK: RGB32 -> RGB16/VQ4
+            std::snprintf(detail, sizeof(detail), "mbc=%u dte=%u ofm=%s", value & 0x7FF,
+                          (value >> 26) & 1, ((value >> 27) & 1) ? "RGB16" : "VQ4");
+            break;
+        case 9: // SETTH
+            std::snprintf(detail, sizeof(detail), "th0=%u th1=%u", value & 0x1FF, (value >> 16) & 0x1FF);
+            break;
+        default:
+            detail[0] = '\0';
+            break;
+        }
+        std::fprintf(stderr, "[trace:ipu] CMD=0x%08X %s %s\n", value, kNames[cmd], detail);
+    }
