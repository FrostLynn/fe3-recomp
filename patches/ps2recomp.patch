+bool VU1Interpreter::tryRunAot(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, PS2Memory *memory)
+{
+    // PS2X_VU1_AOT: use a compiled program for the current code image when one is registered.
+    // PS2X_VU1_DUMP_DIR=<dir>: write every new VU1 code image as vu1_<hash>.bin.
+    static const bool aotVerify = std::getenv("PS2X_VU1_AOT_VERIFY") != nullptr;
+    static const bool aotEnabled = std::getenv("PS2X_VU1_AOT") != nullptr || aotVerify;
+    static const char *dumpDir = std::getenv("PS2X_VU1_DUMP_DIR");
+    if (m_unit != Unit::VU1 || !memory || vuCode != memory->getVU1Code() || (!aotEnabled && !dumpDir))
+        return false;
+    const uint64_t generation = memory->getVU1CodeGeneration();
+    if (!m_aotValid || generation != m_aotGeneration)
+    {
+        m_aotValid = true;
+        m_aotGeneration = generation;
+        const uint64_t hash = ps2HashVu1Code(vuCode, codeSize);
+        m_aotProgram = aotEnabled ? ps2FindVu1AotProgram(hash) : nullptr;
+        if (dumpDir && hash != m_aotLastDumpedHash)
+        {
+            static std::unordered_map<uint64_t, bool> dumped;
+            m_aotLastDumpedHash = hash;
+            if (!dumped[hash])
+            {
+                dumped[hash] = true;
+                char path[512];
+                std::snprintf(path, sizeof(path), "%s/vu1_%016llx.bin", dumpDir, static_cast<unsigned long long>(hash));
+                if (FILE *f = std::fopen(path, "wb"))
+                {
+                    std::fwrite(vuCode, 1, codeSize, f);
+                    std::fclose(f);
+                }
+            }
+        }
+    }
+    if (!m_aotProgram || pipelinesPending())
+        return false;
+    if (aotVerify)
+    {
+        AotVerify &v = g_aotVerify;
+        v.state = m_state;
+        v.startPc = m_state.pc;
+        v.data.assign(vuData, vuData + 0x4000u);
+        v.aotKicks.clear();
+        v.interpKicks.clear();
+        Vu1AotEnv venv;
+        venv.state = &v.state;
+        venv.data = v.data.data();
+        venv.kick = &verifyKick;
+        venv.user = v.data.data();
+        static const long traceRun = std::getenv("PS2X_VU1_AOT_TRACE_RUN") ? std::atol(std::getenv("PS2X_VU1_AOT_TRACE_RUN")) : -1L;
+        g_traceThisRun = static_cast<long>(v.runs + 1) == traceRun;
+        g_traceAot.clear();
+        g_traceInterp.clear();
+        g_vu1AotTraceHook = g_traceThisRun ? &collectTrace : nullptr;
+        v.armed = m_aotProgram(venv);
+        return false; // the interpreter runs for real; verifyAotAfterRun compares
+    }
+    Vu1AotEnv env;
+    env.state = &m_state;
+    env.data = vuData;
+    env.kick = &VU1Interpreter::aotKickThunk;
+    env.user = this;
+    if (!m_aotProgram(env))
+        return false;
+    m_cycle += env.pairs;
+    m_state.cycles = m_cycle;
+    g_vu1Trace.vuCycles.fetch_add(env.pairs, std::memory_order_relaxed);
+    return true;
+}
