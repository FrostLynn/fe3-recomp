+    // A generated function that yielded at a loop head on its entry also leaves
+    // the PC there; it must resume, not return.
+    if (ctx->pc == entryPc && m_eeYieldCount == yieldsBefore)
+    {
+        ctx->pc = getRegU32(ctx, 31);
+    }
+
+    return true;
