+static uint32_t parseWatchField(const char *env, bool second)
+{
+    if (!env)
+        return 0u;
+    const char *colon = std::strchr(env, ':');
+    if (second)
+        return colon ? static_cast<uint32_t>(std::strtoul(colon + 1, nullptr, 16)) : 16u;
+    return static_cast<uint32_t>(std::strtoul(env, nullptr, 16)) & PS2_RAM_MASK;
+}
+uint32_t g_ps2WatchLo = parseWatchField(std::getenv("PS2X_WATCH"), false);
+uint32_t g_ps2WatchLen = std::getenv("PS2X_WATCH") ? parseWatchField(std::getenv("PS2X_WATCH"), true) : 0u;
+bool g_ps2WatchValueOn = std::getenv("PS2X_WATCH_VALUE") != nullptr;
+uint32_t g_ps2WatchValue = g_ps2WatchValueOn ? static_cast<uint32_t>(std::strtoul(std::getenv("PS2X_WATCH_VALUE"), nullptr, 16)) : 0u;
+
