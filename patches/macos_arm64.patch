+void ps2ReportWatchedWrite(uint32_t guestAddr, uint32_t size, uint64_t valueLo, uint64_t valueHi, const char *op, const R5900Context *ctx)
+{
+    // With both PS2X_WATCH and PS2X_WATCH_VALUE set, report only stores that match both.
+    if (g_ps2WatchValueOn && g_ps2WatchLen != 0u)
+    {
+        const bool inRange = (((guestAddr & PS2_RAM_MASK) + size - 1u - g_ps2WatchLo) < g_ps2WatchLen + size - 1u);
+        const bool hasValue = size >= 4u && (static_cast<uint32_t>(valueLo) == g_ps2WatchValue || static_cast<uint32_t>(valueLo >> 32) == g_ps2WatchValue ||
+                                             static_cast<uint32_t>(valueHi) == g_ps2WatchValue || static_cast<uint32_t>(valueHi >> 32) == g_ps2WatchValue);
+        if (!inRange || !hasValue)
+            return;
+    }
+    // The alarm/kernel code that owns a watched structure is usually not interesting:
+    // PS2X_WATCH_IGNORE=<lo>-<hi> skips writes made from that pc range.
+    // Several ranges may be given: PS2X_WATCH_IGNORE=<lo>-<hi>,<lo>-<hi>.
+    static const std::vector<std::pair<uint32_t, uint32_t>> ignores = []()
+    {
+        std::vector<std::pair<uint32_t, uint32_t>> out;
+        for (const char *p = std::getenv("PS2X_WATCH_IGNORE"); p && *p;)
+        {
+            char *end = nullptr;
+            const uint32_t lo = static_cast<uint32_t>(std::strtoul(p, &end, 16));
+            const uint32_t hi = (end && *end == '-') ? static_cast<uint32_t>(std::strtoul(end + 1, &end, 16)) : lo;
+            out.emplace_back(lo, hi);
+            p = (end && *end == ',') ? end + 1 : nullptr;
+        }
+        return out;
+    }();
+    for (const auto &[lo, hi] : ignores)
+        if (ctx && ctx->pc >= lo && ctx->pc < hi)
+            return;
+    static int reports = 0;
+    if (++reports > 2000)
+        return;
+    std::fprintf(stderr, "[watch] %s addr=0x%x size=%u val=%016llx:%016llx pc=0x%x ra=0x%x\n", op ? op : "?", guestAddr, size,
+                 (unsigned long long)valueHi, (unsigned long long)valueLo, ctx ? ctx->pc : 0u,
+                 ctx ? static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[31])) : 0u);
+    if (ctx && reports <= 40)
+    {
+        std::fprintf(stderr, "[watch]   regs:");
+        for (int r = 1; r < 32; ++r)
+            std::fprintf(stderr, " r%d=%x", r, static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[r])));
+        std::fprintf(stderr, "\n");
+    }
+}
